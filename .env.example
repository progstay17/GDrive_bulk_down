# ==============================================================================
# GDrive Batch Zip Downloader - Environment Variables Configuration
# ==============================================================================

# 1. CORE: Google Drive API Key (Public Files Mode)
# ------------------------------------------------------------------------------
# Diperlukan untuk mengakses file publik yang diset sebagai "Anyone with the link".
# Cara Mendapatkan:
#   a. Masuk ke Google Cloud Console (https://console.cloud.google.com/)
#   b. Buat project baru atau pilih project yang sudah ada.
#   c. Cari dan aktifkan "Google Drive API".
#   d. Buka menu "Credentials" -> klik "+ CREATE CREDENTIALS" -> pilih "API key".
#   e. Sangat direkomendasikan untuk membatasi API Key (Restrict key) hanya untuk "Google Drive API" di pengaturan kunci tersebut.
DRIVE_API_KEY=your_google_drive_api_key_here

# 2. SESSION: Session Secret for Iron Session
# ------------------------------------------------------------------------------
# Kunci enkripsi acak minimal sepanjang 32 karakter untuk mengamankan cookie sesi.
# Cara Membuat (Gunakan openssl atau generator string acak):
#   - Melalui terminal: `openssl rand -base64 32` atau `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET=your_32_plus_character_secure_session_secret_here

# 3. OAUTH (OPTIONAL): Google OAuth 2.0 Credentials (Private Files Mode)
# ------------------------------------------------------------------------------
# Set ke "true" untuk mengaktifkan opsi "Login with Google" guna mengunduh file privat.
# Set ke "false" atau kosongkan untuk menonaktifkan fitur ini.
ENABLE_OAUTH_LOGIN=false

# Google OAuth 2.0 Client Credentials.
# Cara Mendapatkan:
#   a. Di Google Cloud Console -> "Credentials" -> klik "+ CREATE CREDENTIALS" -> pilih "OAuth client ID".
#   b. Set Application Type ke "Web application".
#   c. Tambahkan Authorized Redirect URIs:
#      - Untuk lokal: `http://localhost:3000/api/auth/callback`
#      - Untuk produksi (Vercel): `https://nama-app-anda.vercel.app/api/auth/callback`
#   d. Salin Client ID dan Client Secret yang muncul.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
